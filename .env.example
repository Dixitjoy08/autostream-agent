# ── Google Gemini ──────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Salesforce CRM (Web-to-Lead) ───────────────────────────────────
# Find Org ID in Setup → Company Information → Salesforce Organization ID
SF_ORG_ID=your_salesforce_org_id_here

# ── Legacy Salesforce CRM (OAuth2 Connected App) ───────────────────
SF_USERNAME=your_salesforce_email@example.com
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_salesforce_security_token
SF_CONSUMER_KEY=your_connected_app_consumer_key
SF_CONSUMER_SECRET=your_connected_app_consumer_secret
SF_DOMAIN=login

